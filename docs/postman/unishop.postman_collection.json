    {
      "name": "Usuarios",
      "description": "API REST de usuarios (Paso 6.4). Nunca devuelve la contraseña.",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",

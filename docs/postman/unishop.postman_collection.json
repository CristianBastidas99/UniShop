              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Es el producto pedido\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"idProducto\"))));"
                ]
              }
            }
          ]
        },

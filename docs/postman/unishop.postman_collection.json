        {
          "name": "Buscar por categoría, precio y ciudad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/buscar?categoria={{idCategoria}}&precioMin=0&precioMax=100000000&ciudad={{idCiudad}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos",
                "buscar"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "{{idCategoria}}"
                },
                {
                  "key": "precioMin",
                  "value": "0"
                },
                {
                  "key": "precioMax",
                  "value": "100000000"
                },
                {
                  "key": "ciudad",
                  "value": "{{idCiudad}}"
                }
              ]
            },
            "description": "Todos los filtros son opcionales: texto, categoria, precioMin, precioMax, ciudad, calificacionMin."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const cat = Number(pm.collectionVariables.get(\"idCategoria\")), ciu = Number(pm.collectionVariables.get(\"idCiudad\"));",
                  "pm.test(\"Todos cumplen los filtros\", () => pm.response.json().forEach(p => {",
                  "  pm.expect(p.idCiudad).to.eql(ciu);",
                  "  pm.expect(p.categorias.map(c => c.id)).to.include(cat);",
                  "}));"
                ]
              }
            }
          ]
        },

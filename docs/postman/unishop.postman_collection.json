          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Sin contraseñas\", () => pm.response.json().forEach(u => pm.expect(u).to.not.have.property(\"password\")));",
                  "const v = pm.response.json().find(u => u.id === Number(pm.collectionVariables.get(\"idVendedor\")));",
                  "if (v) pm.collectionVariables.set(\"emailVendedor\", v.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

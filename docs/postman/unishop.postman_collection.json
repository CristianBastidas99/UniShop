{
  "info": {
    "name": "UniShop API",
    "description": "API REST de UniShop (Entrega 3). Ejecuta las carpetas en orden: la primera petición guarda ids reales de la base en las variables de la colección. Errores: JSON { \"mensaje\": \"...\" } con 400, 404, 405 o 500.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Productos",
      "description": "API REST de productos (Pasos 6.1 a 6.3). La API no tiene autenticación: el usuario que actúa llega en ?idUsuario.",
      "item": [
        {
          "name": "Listar productos vigentes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "productos"
              ]
            },
            "description": "Devuelve los productos vigentes (fecha límite futura y con unidades). Guarda ids reales para las siguientes peticiones."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código 200\", () => pm.response.to.have.status(200));",
                  "const lista = pm.response.json();",
                  "pm.test(\"Hay al menos un producto con categoría\", () => pm.expect(lista.find(p => p.categorias.length)).to.be.ok);",
                  "const p = lista.find(x => x.categorias.length && x.idCiudad);",
                  "pm.collectionVariables.set(\"idProducto\", p.id);",
                  "pm.collectionVariables.set(\"idVendedor\", p.idVendedor);",
                  "pm.collectionVariables.set(\"idCiudad\", p.idCiudad);",
                  "pm.collectionVariables.set(\"idCategoria\", p.categorias[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener producto por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/productos/{{idProducto}}",
              "host": [

<?xml version="1.0" encoding="UTF-8"?>
<faces-config xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_2.xsd"
              version="2.2">
    <!-- Versión 2.2 a propósito: con 2.3 Mojarra exige CDI y la app no arranca -->
    <application>
        <!-- Toda la aplicación en español: mensajes de JSF, de Bean Validation y de PrimeFaces -->
        <locale-config>
            <default-locale>es</default-locale>
            <supported-locale>es</supported-locale>
        </locale-config>
        <!-- Mensajes propios de JSF (conversión, validación) en src/main/resources/mensajes_es.properties -->
        <message-bundle>mensajes</message-bundle>
    </application>
</faces-config>
